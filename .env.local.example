# ─────────────────────────────────────────────────────────────────
# NORA Website — Environment Configuration
# Copy this file to .env.local and fill in the values.
# .env.local is never committed to source control.
# ─────────────────────────────────────────────────────────────────

# ── WhatsApp CTA ─────────────────────────────────────────────────
# Used for all "Talk to NORA on WhatsApp" CTAs across the site.
# WSC-05 Route B: set to the official NORA WhatsApp URL when ready.
# Leave empty to show a "Coming soon" disabled state (launch default).
# Format when ready: https://wa.me/[full-phone-number-with-country-code]
NEXT_PUBLIC_NORA_WHATSAPP_URL=

# ── NORA Backend (Vercel → Render) ───────────────────────────────
# URL of the NORA NestJS API on Render.
# Production: https://project-need.onrender.com  (or custom domain)
# Local dev:  http://localhost:3001  (if running the backend locally)
#
# This value may be public if it's used client-side elsewhere,
# but for waitlist submissions it is only accessed server-side.
NORA_API_URL=

# Server-to-server authentication secret.
# MUST remain server-side only — NEVER use NEXT_PUBLIC_ prefix.
# Must match NORA_WAITLIST_API_SECRET configured on Render.
# Generate with: openssl rand -base64 48
NORA_API_SECRET=

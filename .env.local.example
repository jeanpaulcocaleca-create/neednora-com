# ─────────────────────────────────────────────────────────────────
# NORA: Environment Configuration
# Copy this file to .env.local and fill in the values.
# .env.local is never committed to source control.
# ─────────────────────────────────────────────────────────────────

# WhatsApp CTA destination URL
# Used for all "Talk to NORA on WhatsApp" CTAs across the site.
# WSC-05 Route B: set this to the official NORA Platform WhatsApp URL
# when the business number is ready.
# Leave empty to show a "Coming soon" disabled state (launch default).
#
# Format when ready: https://wa.me/[full-phone-number-with-country-code]
NEXT_PUBLIC_NORA_WHATSAPP_URL=

# Resend API key (email capture / demo requests)
RESEND_API_KEY=

# ─────────────────────────────────────────────
# NORA Sales API (server-side only — NEVER use NEXT_PUBLIC_ prefix)
# NORA_API_URL: production NORA backend base URL (no trailing slash)
# NORA_SALES_API_SECRET: shared secret matching the value in Render env
# Both variables are read only by src/lib/nora-proxy.ts at server runtime.
# They must NOT be exposed to browser JavaScript under any circumstances.
# ─────────────────────────────────────────────
NORA_API_URL=https://your-nora-backend.onrender.com
NORA_SALES_API_SECRET=

# ─────────────────────────────────────────────
# NORA Demo Agent (future: dedicated sandbox)
# When configured, the website demo forwards to
# an isolated NORA agent. Must have NO access to
# production tenants, customer data, or action tools.
# ─────────────────────────────────────────────
NORA_DEMO_AGENT_URL=
NORA_DEMO_AGENT_TOKEN=

# ─────────────────────────────────────────────
# TRY NORA — Direct LLM (server-side only)
# Used when NORA_DEMO_AGENT_URL is not configured.
# Key is NEVER sent to the browser.
# Provide one of the following:
# ─────────────────────────────────────────────
NORA_DEMO_ANTHROPIC_KEY=
NORA_DEMO_OPENAI_KEY=

# ─────────────────────────────────────────────
# Lead handling
# RESEND_API_KEY: Resend.com API key for email delivery
# NORA_LEAD_EMAIL: destination for leads (defaults to hello@neednora.com)
# ─────────────────────────────────────────────
RESEND_API_KEY=
NORA_LEAD_EMAIL=

# Public website demo → isolated NORA demo-agent bridge.
# Never point this at a production tenant/action endpoint.
NORA_DEMO_AGENT_URL=
NORA_DEMO_AGENT_TOKEN=

# ─────────────────────────────────────────────
# NORA Sales Proxy (server-side only — NEVER use NEXT_PUBLIC_ prefix)
# NORA_API_URL: production NORA backend base URL (no trailing slash)
# NORA_SALES_API_SECRET: shared secret matching the value in Render env
# Both variables are read only by src/lib/nora-proxy.ts at server runtime.
# They must NOT be exposed to browser JavaScript under any circumstances.
# ─────────────────────────────────────────────
NORA_API_URL=https://your-nora-backend.onrender.com
NORA_SALES_API_SECRET=
